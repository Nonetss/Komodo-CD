---
import { type Lang, t } from "@/i18n/ui"

interface Props {
  lang: Lang
  class?: string
}

const { lang, class: className } = Astro.props
const dict = t(lang)
const n = dict.arch.nodes
const r = dict.arch.roles

// Topología del stack de Docker Compose dibujada con los tokens del sitio,
// así sigue al tema. Coordenadas en el espacio 1200×428 (el viewBox recorta
// los 40 vacíos de arriba); cada caja mide 76 de alto y se rotula desde su
// borde izquierdo.
interface Box {
  x: number
  y: number
  w: number
  name: string
  port?: string
  role?: string
}

const boxes: Box[] = [
  { x: 20, y: 124, w: 170, name: n.browser },
  { x: 20, y: 312, w: 170, name: n.ci, role: r.ci },
  {
    x: 290,
    y: 124,
    w: 240,
    name: n.caddy,
    port: ":80",
    role: `${r.caddy} · ${dict.arch.published}`,
  },
  { x: 290, y: 312, w: 240, name: n.astro, port: ":4321", role: r.astro },
  { x: 660, y: 124, w: 230, name: n.backend, port: ":3000", role: r.backend },
  { x: 660, y: 312, w: 230, name: n.sqlite, port: "/data", role: r.sqlite },
  { x: 960, y: 124, w: 220, name: n.komodo, role: r.komodo },
  { x: 960, y: 312, w: 220, name: n.servers, role: r.servers },
]

// Marcos de los dos contenedores de la columna central: el gateway (Caddy,
// el único puerto publicado) y el frontend (Astro SSR, solo en la red).
interface Frame {
  y: number
  name: string
}

const frames: Frame[] = [
  { y: 60, name: n.gateway },
  { y: 248, name: n.frontend },
]

interface Edge {
  d: string
  /** Tráfico de Komodo (Core → Periphery): no pasa por Komodo CD. */
  external?: boolean
  label: string
  lx: number
  ly: number
  anchor?: "start" | "middle" | "end"
}

const edges: Edge[] = [
  { d: "M190,162 H284", label: "HTTPS", lx: 237, ly: 152 },
  {
    d: "M190,350 H235 V182 H284",
    label: "x-api-key",
    lx: 196,
    ly: 372,
    anchor: "start",
  },
  { d: "M410,200 V306", label: "/*", lx: 420, ly: 238, anchor: "start" },
  { d: "M530,162 H654", label: "/rpc /api", lx: 602, ly: 152 },
  {
    d: "M530,350 H580 V182 H654",
    label: "/api/auth",
    lx: 588,
    ly: 270,
    anchor: "start",
  },
  { d: "M775,200 V306", label: "SQL", lx: 785, ly: 257, anchor: "start" },
  { d: "M890,162 H954", label: "HTTPS", lx: 925, ly: 152 },
  {
    d: "M1070,200 V306",
    external: true,
    label: "pull · deploy",
    lx: 1080,
    ly: 257,
    anchor: "start",
  },
]
---

<svg
  viewBox="0 40 1200 388"
  role="img"
  aria-labelledby="arch-diagram-title arch-diagram-desc"
  class:list={["h-auto w-full", className]}
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="arch-diagram-title">{dict.arch.diagramTitle}</title>
  <desc id="arch-diagram-desc">{dict.arch.diagramDesc}</desc>
  <defs>
    <marker
      id="arch-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" class="fill-muted-foreground"></path>
    </marker>
  </defs>

  <!-- Contenedores del gateway y del frontend, cada uno con su imagen. -->
  {frames.map((frame) => (
  <g>
    <rect
      x="270"
      y={frame.y}
      width="280"
      height="160"
      rx="10"
      class="fill-none stroke-border"
    />
    <text
      x="288"
      y={frame.y + 32}
      class="font-sans text-[16px] font-medium fill-strong"
    >
      {frame.name}
    </text>
    <text
      x="532"
      y={frame.y + 32}
      text-anchor="end"
      class="font-mono text-[12px] fill-muted-foreground"
    >
      {r.container}
    </text>
  </g>
))}

  <g class="fill-none stroke-muted-foreground" stroke-width="1.25">
    {edges.map((edge) => (
  <path
    d={edge.d}
    marker-end="url(#arch-arrow)"
    stroke-dasharray={edge.external ? "5 4" : undefined}
  />
))}
  </g>

  <g class="font-mono text-[12px] fill-muted-foreground arch-halo">
    {edges.map((edge) => (
  <text x={edge.lx} y={edge.ly} text-anchor={edge.anchor ?? "middle"}>
    {edge.label}
  </text>
))}
  </g>

  {boxes.map((box) => (
  <g>
    <rect
      x={box.x}
      y={box.y}
      width={box.w}
      height="76"
      rx="8"
      class="fill-card stroke-border"
    />
    <text
      x={box.x + 18}
      y={box.role ? box.y + 32 : box.y + 43}
      class="font-sans text-[16px] font-medium fill-strong"
    >
      {box.name}
    </text>
    {box.port && (
      <text
        x={box.x + box.w - 18}
        y={box.y + 32}
        text-anchor="end"
        class="font-mono text-[13px] fill-muted-foreground"
      >
        {box.port}
      </text>
    )}
    {box.role && (
      <text
        x={box.x + 18}
        y={box.y + 54}
        class="font-mono text-[12px] fill-muted-foreground"
      >
        {box.role}
      </text>
    )}
  </g>
))}
</svg>
