---
import { type Lang, t } from "@/i18n/ui"

interface Props {
  lang: Lang
  class?: string
}

const { lang, class: className } = Astro.props
const dict = t(lang)
const n = dict.arch.nodes
const r = dict.arch.roles

// Topología del stack de Docker Compose dibujada con los tokens del sitio,
// así sigue al tema. Coordenadas en el espacio 1200×420 (el viewBox recorta
// los 40 vacíos de arriba); cada caja mide 76 de alto y se rotula desde su
// borde izquierdo.
interface Box {
  x: number
  y: number
  w: number
  name: string
  port?: string
  role?: string
}

const boxes: Box[] = [
  { x: 20, y: 132, w: 170, name: n.browser },
  { x: 20, y: 300, w: 170, name: n.ci, role: r.ci },
  {
    x: 300,
    y: 132,
    w: 220,
    name: n.caddy,
    port: ":80",
    role: `${r.caddy} · ${dict.arch.published}`,
  },
  { x: 300, y: 300, w: 220, name: n.astro, port: ":4321", role: r.astro },
  { x: 640, y: 132, w: 230, name: n.backend, port: ":3000", role: r.backend },
  { x: 640, y: 300, w: 230, name: n.sqlite, port: "/data", role: r.sqlite },
  { x: 960, y: 132, w: 220, name: n.komodo, role: r.komodo },
  { x: 960, y: 300, w: 220, name: n.servers, role: r.servers },
]

interface Edge {
  d: string
  /** Tráfico de Komodo (Core → Periphery): no pasa por Komodo CD. */
  external?: boolean
  label: string
  lx: number
  ly: number
  anchor?: "start" | "middle" | "end"
}

const edges: Edge[] = [
  { d: "M190,170 H294", label: "HTTPS", lx: 242, ly: 160 },
  {
    d: "M190,338 H240 V190 H294",
    label: "x-api-key",
    lx: 196,
    ly: 360,
    anchor: "start",
  },
  { d: "M410,208 V294", label: "/*", lx: 420, ly: 256, anchor: "start" },
  { d: "M520,170 H634", label: "/rpc /api", lx: 580, ly: 160 },
  { d: "M755,208 V294", label: "SQL", lx: 765, ly: 256, anchor: "start" },
  { d: "M870,170 H954", label: "HTTPS", lx: 912, ly: 160 },
  {
    d: "M1070,208 V294",
    external: true,
    label: "pull · deploy",
    lx: 1080,
    ly: 256,
    anchor: "start",
  },
]
---

<svg
  viewBox="0 40 1200 380"
  role="img"
  aria-labelledby="arch-diagram-title arch-diagram-desc"
  class:list={["h-auto w-full", className]}
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="arch-diagram-title">{dict.arch.diagramTitle}</title>
  <desc id="arch-diagram-desc">{dict.arch.diagramDesc}</desc>
  <defs>
    <marker
      id="arch-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L10,5 L0,10 z" class="fill-muted-foreground"></path>
    </marker>
  </defs>

  <!-- Contenedor del frontend: Caddy y Astro SSR van en la misma imagen. -->
  <g>
    <rect
      x="280"
      y="60"
      width="260"
      height="340"
      rx="10"
      class="fill-none stroke-border"
    ></rect>
    <text x="298" y="92" class="font-sans text-[16px] font-medium fill-strong">
      {n.frontend}
    </text>
    <text
      x="522"
      y="92"
      text-anchor="end"
      class="font-mono text-[12px] fill-muted-foreground"
    >
      {r.container}
    </text>
  </g>

  <g class="fill-none stroke-muted-foreground" stroke-width="1.25">
    {edges.map((edge) => (
  <path
    d={edge.d}
    marker-end="url(#arch-arrow)"
    stroke-dasharray={edge.external ? "5 4" : undefined}
  />
))}
  </g>

  <g class="font-mono text-[12px] fill-muted-foreground arch-halo">
    {edges.map((edge) => (
  <text x={edge.lx} y={edge.ly} text-anchor={edge.anchor ?? "middle"}>
    {edge.label}
  </text>
))}
  </g>

  {boxes.map((box) => (
  <g>
    <rect
      x={box.x}
      y={box.y}
      width={box.w}
      height="76"
      rx="8"
      class="fill-card stroke-border"
    />
    <text
      x={box.x + 18}
      y={box.role ? box.y + 32 : box.y + 43}
      class="font-sans text-[16px] font-medium fill-strong"
    >
      {box.name}
    </text>
    {box.port && (
      <text
        x={box.x + box.w - 18}
        y={box.y + 32}
        text-anchor="end"
        class="font-mono text-[13px] fill-muted-foreground"
      >
        {box.port}
      </text>
    )}
    {box.role && (
      <text
        x={box.x + 18}
        y={box.y + 54}
        class="font-mono text-[12px] fill-muted-foreground"
      >
        {box.role}
      </text>
    )}
  </g>
))}
</svg>
