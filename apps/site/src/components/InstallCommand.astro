---
import { Code } from "astro:components"
import CopyButton from "@/components/CopyButton.astro"
import { INSTALL_COMMAND, type Lang, t } from "@/i18n/ui"

interface Props {
  lang: Lang
  label?: string
}

const { lang, label } = Astro.props
const dict = t(lang)
---

<!-- El comando se resalta con el mismo tema de Shiki que los bloques de las
     docs (astro.config.mjs), sobre el fondo del marco. -->
<figure class="terminal-frame" data-copy-scope>
  {label && (
  <figcaption class="terminal-bar gap-2 px-4 py-2 text-label-caps text-terminal-muted">
    <span class="size-1.5 rounded-full bg-terminal-accent" aria-hidden="true" />
    {label}
  </figcaption>
)}
  <div class="flex items-start gap-3 py-3.5 pr-2 pl-4">
    <pre
      class="min-w-0 flex-1 py-1 text-data break-all whitespace-pre-wrap text-terminal-fg"
    ><span class="text-terminal-accent select-none" aria-hidden="true">$ </span><Code
        code={INSTALL_COMMAND}
        lang="bash"
        theme="github-dark-default"
        inline
        class="bg-transparent!"
      /></pre>
    <CopyButton lang={lang} text={INSTALL_COMMAND} label={dict.copy.label} />
  </div>
</figure>

<script>
import { bindCopyButtons } from "@/lib/copy"

bindCopyButtons()
</script>
