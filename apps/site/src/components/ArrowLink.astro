---
import ArrowRight from "@lucide/astro/icons/arrow-right"

// El enlace fuerte del sitio: texto en tinta y una flecha azul que se
// desplaza a la derecha al pasar el ratón.
interface Props {
  href: string
  class?: string
}

const { href, class: className } = Astro.props
---

<a
  href={href}
  class:list={[
  "focus-ring group inline-flex items-center gap-1.5 rounded-sm font-medium text-strong",
  className,
]}
>
  <slot />
  <ArrowRight
    class="size-4 text-primary transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5"
    stroke-width={1.75}
  />
</a>
