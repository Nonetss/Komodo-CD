---
import { StacksPage } from "@/features/stacks"
import DashboardLayout from "@/layouts/dashboard.astro"

// Astro ya entrega el parámetro decodificado. Si no hay ningún stack con ese
// nombre, la isla muestra el estado de "no encontrado".
const { name } = Astro.params
---

<DashboardLayout surface="stacks">
  <StacksPage
    client:load
    transition:persist="stacks-page"
    stack={name ?? null}
    lang={Astro.locals.lang}
  />
</DashboardLayout>
