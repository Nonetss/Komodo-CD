---
import "@/styles/global.css"

import { Font } from "astro:assets"
import { ClientRouter, fade } from "astro:transitions"

const { title } = Astro.props

const { lang } = Astro.locals
// Al navegar, toda la página hace el mismo fundido corto. Las barras tienen
// nombre propio y no se animan (global.css)
const pageFade = fade({ duration: "0.2s" })
---

<html lang={lang} transition:animate={pageFade}>
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    >
    <meta name="color-scheme" content="light dark">
    <link rel="icon" type="image/svg+xml" href="/logo.svg">
    <Font
      cssVariable="--font-schibsted-grotesk"
      preload={[{ subset: "latin" }]}
    />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ subset: "latin" }]} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
    // Claro por defecto: solo `theme=dark` activa el tema oscuro
    function applyTheme(doc) {
      const stored = localStorage.getItem("theme")
      doc.documentElement.classList.toggle("dark", stored === "dark")
    }
    applyTheme(document)
    document.addEventListener("astro:before-swap", (event) =>
      applyTheme(event.newDocument)
    )
    </script>
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
