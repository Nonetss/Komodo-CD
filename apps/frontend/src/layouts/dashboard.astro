---
import { Wordmark } from "@/components/shared/brand/wordmark"
import { Toaster } from "@/components/shared/feedback/toaster"
import {
  BottomNav,
  type NavItem,
  ShellControls,
  StackSearch,
  TopNav,
} from "@/features/app-shell"
import Main from "@/layouts/main.astro"
import { APP_SURFACES, type SurfaceId } from "@/lib/app-surfaces"
import { getI18n } from "@/lib/i18n"

interface Props {
  /** Página actual: da el título del documento (`nav.<surface>`) */
  surface: SurfaceId
  /**
   * La página ocupa todo el ancho bajo la barra y pone sus propios márgenes
   * (p. ej. el maestro–detalle de stacks, con su columna pegada al borde)
   */
  bleed?: boolean
}

const { surface, bleed = false } = Astro.props
const { lang } = Astro.locals
const { t } = getI18n(lang)

const NAV: NavItem[] = APP_SURFACES.map((s) => ({
  key: s.id,
  href: s.path,
  label: t(`nav.${s.id}`),
}))

const path = Astro.url.pathname

// Contenido de las páginas normales: columna centrada. La barra superior va
// a todo el ancho con los mismos márgenes laterales
const gutter = "px-4 sm:px-6 lg:px-10"
const container = `mx-auto w-full max-w-6xl ${gutter}`
---

<Main title={`${t(`nav.${surface}`)} · Komodo CD`}>
  <!--
    Barra superior, en todos los tamaños. En escritorio lleva la navegación;
    en móvil solo marca y controles, y la navegación va en la barra inferior.
    No es `transition:persist` porque el elemento activo se renderiza en SSR:
    se sustituye en cada navegación, con nombre propio y sin animación.
  -->
  <header
    class="bg-background border-rule sticky top-0 z-30 h-14 rule-b"
    transition:name="top-bar"
  >
    <div class:list={[gutter, "flex h-full items-stretch gap-8"]}>
      <a href="/" class="flex shrink-0 items-center">
        <Wordmark />
      </a>
      <TopNav items={NAV} path={path} />
      <div class="ml-auto flex shrink-0 items-center gap-6">
        <div class="hidden lg:block">
          <StackSearch client:load lang={lang} />
        </div>
        <div class="flex items-center gap-0.5">
          <ShellControls client:load lang={lang} />
        </div>
      </div>
    </div>
  </header>

  <main
    class:list={[
  bleed
    ? "pb-mobile-nav lg:pb-0"
    : [container, "pb-mobile-nav pt-6 lg:pt-10 lg:pb-12"],
]}
  >
    <slot />
  </main>

  <BottomNav items={NAV} path={path} />
  <Toaster client:idle />
</Main>
