---
import { fade } from "astro:transitions"

import { Toaster } from "@/components/shared/feedback/toaster"
import {
  BottomNav,
  type NavItem,
  ShellControls,
  TopNav,
} from "@/features/app-shell"
import Main from "@/layouts/main.astro"
import { APP_SURFACES, type SurfaceId } from "@/lib/app-surfaces"
import { getI18n } from "@/lib/i18n"

interface Props {
  /** Página actual: da el título del documento (`nav.<surface>`) */
  surface: SurfaceId
}

const { surface } = Astro.props
const { user, lang } = Astro.locals
const { t } = getI18n(lang)

const NAV: NavItem[] = APP_SURFACES.map((s) => ({
  key: s.id,
  href: s.path,
  label: t(`nav.${s.id}`),
}))

const path = Astro.url.pathname
const initial = (user?.name || user?.email || "?").charAt(0).toUpperCase()

// Mismo ancho y márgenes que <main>: la barra se alinea con la página
const container = "mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-10"
---

<Main title={`${t(`nav.${surface}`)} · Komodo CD`}>
  <!--
    Barra superior, en todos los tamaños. En escritorio lleva la navegación;
    en móvil solo marca y controles, y la navegación va en la barra inferior.
    No es `transition:persist` porque el elemento activo se renderiza en SSR:
    se sustituye en cada navegación, con nombre propio y sin animación.
  -->
  <header
    class="bg-background border-rule sticky top-0 z-30 border-b-[1.5px]"
    transition:name="top-bar"
  >
    <div class:list={[container, "flex h-14 items-stretch gap-8"]}>
      <a href="/" class="flex min-w-0 shrink-0 items-center gap-2.5">
        <img src="/logo.svg" alt="" aria-hidden="true" class="h-5 w-auto">
        <span
          class="text-headline type-expanded truncate font-black tracking-tight uppercase"
          >Komodo CD</span
        >
      </a>
      <TopNav items={NAV} path={path} />
      <div class="ml-auto flex shrink-0 items-center gap-3">
        <span
          class="hidden items-center gap-2.5 lg:flex"
          title={user?.email ?? undefined}
        >
          <span
            class="border-rule flex size-7 shrink-0 items-center justify-center border-[1.5px] font-mono text-xs font-medium"
            aria-hidden="true">{initial}</span
          >
          <span class="text-meta hidden max-w-40 truncate font-medium xl:inline"
            >{user?.name}</span
          >
        </span>
        <div class="flex items-center gap-0.5">
          <ShellControls client:load lang={lang} />
        </div>
      </div>
    </div>
  </header>

  <main
    class:list={[container, "pb-mobile-nav pt-6 lg:pt-10 lg:pb-12"]}
    transition:animate={fade({ duration: "0.2s" })}
    transition:name="dashboard-page"
  >
    <slot />
  </main>

  <BottomNav items={NAV} path={path} />
  <Toaster client:idle />
</Main>
