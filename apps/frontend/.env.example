# ─── URL pública (embebida en el bundle) ─────────────────────────────────────
# Se muestra en los snippets curl del dashboard.
# Si no se define en build time, el cliente usa window.location.origin como fallback.
PUBLIC_APP_URL="http://localhost:4321"

# ─── Backend — sólo para Caddy (Docker) ──────────────────────────────────────
# URL interna al contenedor backend. Caddy la usa para hacer proxy de /api, /rpc,
# /doc y /scalar.
# No se expone al navegador. Por defecto apunta al servicio "backend" del compose.
BACKEND_URL="http://localhost:3000"

# ─── Backend — interno para SSR (Astro) ──────────────────────────────────────
# Lo usa `src/lib/auth-server.ts` (vía `astro:env/server`) para que el middleware
# pueda llamar a /api/auth/* desde el contenedor del frontend. Se lee en RUNTIME,
# no se hornea en el build, así que se puede cambiar sin reconstruir la imagen.
INTERNAL_BACKEND_URL="http://localhost:3000"
