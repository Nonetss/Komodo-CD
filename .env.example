# ─────────────────────────────────────────────────────────────────────────────
# El único fichero de entorno del repo. Cópialo a `.env` en la raíz: lo leen
# Docker Compose (compose.yml, compose.build.yml) y el desarrollo local
# (backend, frontend y Drizzle CLI). Una variable definida en la shell gana
# sobre este fichero.
#
# Para un despliegue basta con la primera parte; compose fija él mismo
# DATABASE_URL y BACKEND_URL e ignora la sección de desarrollo.
# ─────────────────────────────────────────────────────────────────────────────

# ─── URL pública de la app ────────────────────────────────────────────────────
# Sin trailing slash. El backend la recibe como BETTER_AUTH_URL y la usa para
# CORS y trusted origins. En desarrollo: http://localhost:4321
# Ejemplo: https://deploy.example.com
APP_URL=https://app.example.com

# Puerto que Caddy expone en el host (por defecto 80). Solo Docker.
PORT=80

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Clave secreta para firmar sesiones y tokens.
# Genera una con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ─── Admin inicial ────────────────────────────────────────────────────────────
# Se crea automáticamente al arrancar el backend si no existe (por email).
# La contraseña necesita al menos 8 caracteres.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# ─── Desarrollo local (bun run dev) ──────────────────────────────────────────
# SQLite. Las rutas `file:./…` son relativas a apps/backend.
DATABASE_URL="file:./dev.db"

# fatal | error | warn | info | debug | trace (por defecto: info)
# LOG_LEVEL=debug

# Dónde llegan al backend el SSR de Astro y el proxy de Vite.
# BACKEND_URL=http://localhost:3000

# URL de los snippets curl del dashboard, embebida en el build. Sin ella se usa
# el origen del navegador.
# PUBLIC_APP_URL=http://localhost:4321
