{
  "name": "komodo-cd",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/api-key": "1.7.6",
      "better-auth": "1.7.6",
      "@libsql/client": "^0.18.0",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "@orpc/client": "^1.15.4",
      "@orpc/openapi": "^1.15.4",
      "@orpc/server": "^1.15.4",
      "@orpc/zod": "^1.15.4",
      "hono": "^4.13.11",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "dotenv": "^18.0.4",
      "zod": "^4.6.5",
      "typescript": "^6",
      "@types/bun": "^1.4.2",
      "@orpc/tanstack-query": "^1.15.4",
      "astro": "7.3.5",
      "@astrojs/check": "^0.9.10",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo watch dev --filter=!site",
    "dev:backend": "turbo watch -F backend dev",
    "dev:frontend": "turbo watch -F frontend dev",
    "dev:site": "turbo watch -F site dev",
    "build": "turbo build",
    "start": "turbo start",
    "check-types": "turbo check-types",
    "format": "biome check --write --linter-enabled=false .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "tailwind:check": "bun run scripts/patch-tailwint.mjs && (cd apps/frontend && tailwint) && (cd apps/site && tailwint)",
    "tailwind:fix": "bun run scripts/patch-tailwint.mjs && (cd apps/frontend && tailwint --fix) && (cd apps/site && tailwint --fix)",
    "db:generate": "turbo -F @komodo-cd/db db:generate",
    "db:check": "turbo -F @komodo-cd/db db:check",
    "db:push": "turbo -F @komodo-cd/db db:push",
    "db:migrate": "turbo -F @komodo-cd/db db:migrate",
    "db:studio": "turbo -F @komodo-cd/db db:studio",
    "docker:build": "docker compose -f compose.build.yml build",
    "docker:up": "docker compose -f compose.build.yml up -d --build",
    "docker:down": "docker compose -f compose.build.yml down",
    "docker:logs": "docker compose -f compose.build.yml logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@komodo-cd/config": "workspace:*",
    "@types/bun": "catalog:",
    "tailwint": "1.1.15",
    "turbo": "^2.11.5",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
